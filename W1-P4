class Solution {
    public int maxSubArray(int[] nums) {
        int n = nums.length;
        int M = Integer.MIN_VALUE;
        int N = 0;
        for(int i = 0;i<n;i++){
            N=N+nums[i];
            if(N>M){
                M = N;
            }
            if(N<0){
                N=0;
            }

        }
        return M;
    }
}
